# Public/non-secret social login identifiers. Committed to git — see
# .env.example and 간편로그인-수정금지-지침.md for why this is safe.

NEXT_PUBLIC_GOOGLE_CLIENT_ID=139627104931-ms36h73qdavldvo8p0k5drj2hclmglod.apps.googleusercontent.com
TIG_GOOGLE_CLIENT_ID=139627104931-ms36h73qdavldvo8p0k5drj2hclmglod.apps.googleusercontent.com
# Origins this app is allowed to load Google Identity Services from. Must also
# be added as an "승인된 자바스크립트 원본" (Authorized JavaScript origin) for this
# client id in Google Cloud Console, or the Google button will stay disabled.
NEXT_PUBLIC_GOOGLE_ALLOWED_ORIGINS=http://localhost:5501,http://127.0.0.1:5501,http://100.67.223.117:5501

TIG_NAVER_CLIENT_ID=DR3FjbwzeONOCRVgZPMY

TIG_KAKAO_REST_API_KEY=dfe710f05900c59347e74e9186a626e4
# Kakao JS SDK key — not currently used by any code in this repo (login uses
# the REST API key + server-side redirect flow instead), kept for future use.
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=a2b4ff473cb17a6f348697b0f14cc807

# Redirect URIs intentionally left unset: backend/social-oauth-config.js falls
# back to `${request origin}/api/auth/{provider}/callback`, so this works from
# both localhost and the Tailscale address without editing this file. Make
# sure every host you test from (localhost:5501, the Tailscale IP, etc.) is
# registered as an allowed redirect URI in the Kakao/Naver developer console.
