# Google OAuth Client ID is a public browser identifier, not a client secret.
# Keep the same value in both variables so the frontend renders the button and
# the backend verifies the Google ID token audience against the same client.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id.apps.googleusercontent.com
TIG_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id.apps.googleusercontent.com

# Naver and Kakao OAuth secrets are used only by the Node backend.
# Do not expose these as NEXT_PUBLIC_* variables.
TIG_NAVER_CLIENT_ID=replace-with-naver-client-id
TIG_NAVER_CLIENT_SECRET=replace-with-naver-client-secret
TIG_NAVER_REDIRECT_URI=http://localhost:5501/api/auth/naver/callback

TIG_KAKAO_REST_API_KEY=replace-with-kakao-rest-api-key
# Kakao REST API keys require a client secret by default.
# Set TIG_KAKAO_CLIENT_SECRET_REQUIRED=0 only after disabling the client secret feature in Kakao Developers.
TIG_KAKAO_CLIENT_SECRET=replace-with-kakao-client-secret
TIG_KAKAO_CLIENT_SECRET_REQUIRED=1
TIG_KAKAO_REDIRECT_URI=http://localhost:5501/api/auth/kakao/callback
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=replace-with-kakao-javascript-key

# Enables deterministic local/CI callback tests without calling Naver or Kakao.
# Never enable in production.
TIG_SOCIAL_AUTH_TEST_MODE=0
