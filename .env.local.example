# Real secrets. Copy this file to .env.local and fill in real values.
#
# .env.local is gitignored — it must never be committed. Unlike .env (public
# identifiers), everything in here grants real access if leaked.
# See 간편로그인-수정금지-지침.md for why this split exists.

# Naver/Kakao OAuth client secrets — used only by the Node backend, never sent
# to the browser. Leaking these lets someone impersonate this app to Naver/Kakao.
TIG_NAVER_CLIENT_SECRET=replace-with-naver-client-secret
TIG_KAKAO_CLIENT_SECRET=replace-with-kakao-client-secret
# Kakao REST API keys require a client secret by default.
# Set TIG_KAKAO_CLIENT_SECRET_REQUIRED=0 only after disabling the client
# secret feature in Kakao Developers.
TIG_KAKAO_CLIENT_SECRET_REQUIRED=1

# Enables deterministic local/CI callback tests without calling Naver or Kakao.
# Never enable in production.
TIG_SOCIAL_AUTH_TEST_MODE=0

# Server runtime secrets — not login-specific, but must never be committed either.
TIG_ADMIN_TOKEN=replace-with-a-long-random-admin-token
TIG_APP_ATTESTATION_SECRET=replace-with-a-long-random-attestation-secret
TIG_SECRET=replace-with-a-long-random-runtime-secret
